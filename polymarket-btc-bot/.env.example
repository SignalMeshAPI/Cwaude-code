# =============================================================================
# Polymarket BTC 15-Minute Trading Bot - Configuration
#
# Copy to .env and fill in values. The .env file is git-ignored.
# Settings are loaded by src/polymarket_btc_bot/config.py via pydantic-settings.
# Hard safety floors live in code; env can only TIGHTEN them, never loosen.
# =============================================================================

# -------- Wallet & Polymarket auth (REQUIRED FOR LIVE TRADING) ----------------
# Polygon EOA private key. NEVER commit this. Treat it like a bearer token.
# (POLYMARKET_PK is also accepted as an alias for compatibility with the
# upstream aulekator bot.)
POLYMARKET_PRIVATE_KEY=0xreplace_me

# Optional: pre-supplied L2 API creds skip the derivation step on startup.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# CLOB host. Use the production endpoint unless you know what you're doing.
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# -------- Run mode ------------------------------------------------------------
# live | paper. Can be flipped at runtime via Redis: SET pmbot:mode paper
PMBOT_MODE=paper

# Prometheus metrics port
METRICS_PORT=9100

# -------- Risk caps (env can only TIGHTEN, code enforces floors) --------------
# (MAX_POSITION_SIZE is an alias for MAX_BET_USD for upstream compatibility.)
MAX_BET_USD=2.0
STOP_LOSS_PCT=0.30
TAKE_PROFIT_PCT=0.20
MIN_EDGE_CONFIDENCE=0.55
MAX_CONCURRENT_POSITIONS=1
MAX_DAILY_LOSS_USD=10.0
MAX_WEEKLY_LOSS_USD=30.0
KILL_SWITCH_CONSECUTIVE_LOSSES=5
MIN_BANKROLL_USD=10.0

# -------- Signal tuning -------------------------------------------------------
SPIKE_THRESHOLD_Z=3.0          # z-score that maps to confidence=1.0
DIVERGENCE_THRESHOLD_BPS=5.0   # cross-exchange spread (bps) that maps to conf=1.0

# -------- Data sources --------------------------------------------------------
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com/ws
COINBASE_REST=https://api.exchange.coinbase.com
FEAR_GREED_URL=https://api.alternative.me/fng/
SOLANA_REST=https://api.coinbase.com/v2  # SOL-USD spot via Coinbase v2

# Reddit read-only (public subs - no API keys needed for read access via PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=polymarket-btc-bot/0.1
REDDIT_SUBREDDITS=Bitcoin,CryptoCurrency

# -------- Redis ---------------------------------------------------------------
# Either set REDIS_URL outright, or use REDIS_HOST/REDIS_PORT/REDIS_DB (the
# legacy aulekator-bot env naming). REDIS_URL takes precedence if non-default.
REDIS_URL=redis://redis:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# -------- Learning ------------------------------------------------------------
LEARNING_DB_PATH=/data/learning.db
LEARNING_RATE=0.02
LEARNING_DECAY=0.999
LEARNING_REPLAY_SIZE=1000
LEARNING_WEIGHT_FLOOR=0.05

# -------- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
